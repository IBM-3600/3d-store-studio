// ═══════════════════════════════════════════════════════════════
// 3D STORE STUDIO — prisma/schema.prisma
// Handles: Design, Asset Management, App Registry, Publishing
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum WorldStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AppStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum PublishState {
  PENDING
  SUCCESS
  FAILED
  ROLLED_BACK
}

enum AssetType {
  MODEL
  TEXTURE
  AUDIO
  VIDEO
  HDRI
  FONT
}

enum AssetStatus {
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum SceneNodeType {
  PRODUCT
  DECORATION
  LIGHT
  CAMERA
  SHELF
  WALL
  FLOOR
  SIGN
  GROUP
  SPAWN_POINT
}

enum InteractionType {
  NONE
  OPEN_MODAL
  REDIRECT
  ADD_TO_CART
  PLAY_ANIMATION
  CUSTOM
}

enum CommentStatus {
  OPEN
  RESOLVED
}

// ────────────────────────────────────────────
// IDENTITY & ACCESS
// ────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  displayName   String?
  role          UserRole  @default(VIEWER)
  isActive      Boolean   @default(true)
  lastActive    DateTime?

  applications  Application[]
  auditLogs     AuditLog[]
  comments      Comment[]
  sessions      Session[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ────────────────────────────────────────────
// APPLICATION REGISTRY (3D Stores)
// ────────────────────────────────────────────

model Application {
  id               String      @id @default(uuid())
  name             String
  slug             String      @unique
  description      String?
  website          String?
  logoUrl          String?
  ownerId          String
  owner            User        @relation(fields: [ownerId], references: [id])
  status           AppStatus   @default(ACTIVE)

  sourceName       String?
  secret           String?
  version          String?
  // Communication
  allowedOrigins   String[]    @default([])
  webhookSecret    String?
  bucketBaseUrl    String?

  apiKeys          ApiKey[]
  environments     AppEnvironment[]
  webhooks         Webhook[]
  publishRecords   PublishRecord[]
  integrationLogs  IntegrationLog[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([ownerId])
}

model ApiKey {
  id          String       @id @default(uuid())
  appId       String
  app         Application  @relation(fields: [appId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String
  keyPrefix   String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean      @default(true)
  scopes      String[]     @default([])
  createdAt   DateTime     @default(now())

  @@index([appId])
  @@index([keyPrefix])
}

model AppEnvironment {
  id                  String           @id @default(uuid())
  appId               String
  app                 Application      @relation(fields: [appId], references: [id], onDelete: Cascade)
  name                String
  type                EnvironmentType

  // 3D store endpoint for this environment
  storeUrl            String?
  notifyEndpoint      String?

  // Current deployment state (unique per app+env)
  currentWorldId      String?
  currentWorldName    String?
  currentVersion      Int              @default(0)
  currentJsonUrl      String?
  currentContentHash  String?
  lastDeployedAt      DateTime?
  isActive            Boolean          @default(true)

  publishRecords      PublishRecord[]

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([appId, type])
  @@index([appId])
}

model Webhook {
  id               String       @id @default(uuid())
  appId            String
  app              Application  @relation(fields: [appId], references: [id], onDelete: Cascade)
  url              String
  events           String[]     @default([])
  secret           String
  isActive         Boolean      @default(true)
  lastTriggeredAt  DateTime?
  lastStatus       Int?
  lastResponse     String?
  createdAt        DateTime     @default(now())

  @@index([appId])
}

model IntegrationLog {
  id          String       @id @default(uuid())
  appId       String
  app         Application  @relation(fields: [appId], references: [id], onDelete: Cascade)
  action      String
  endpoint    String?
  method      String?
  statusCode  Int?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime     @default(now())

  @@index([appId, createdAt])
}

// ────────────────────────────────────────────
// WORLD DESIGN
// ────────────────────────────────────────────

model World {
  id                String         @id @default(uuid())
  name              String
  description       String?
  slug              String         @unique
  status            WorldStatus    @default(DRAFT)
  currentVersion    Int            @default(0)
  publishedJsonUrl  String?

  environment       Json?
  navigationConfig  Json?
  metadata          Json?
  createdBy         String?

  sceneNodes        SceneNode[]
  worldAssets       WorldAsset[]
  publishHistory    PublishRecord[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
}

model SceneNode {
  id               String          @id @default(uuid())
  worldId          String
  world            World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  nodeName         String
  nodeType         SceneNodeType   @default(DECORATION)

  assetId          String?
  asset            Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)

  // Transform
  position         Json            @default("{\"x\":0,\"y\":0,\"z\":0}")
  rotation         Json            @default("{\"x\":0,\"y\":0,\"z\":0}")
  scale            Json            @default("{\"x\":1,\"y\":1,\"z\":1}")

  // Rendering
  visible          Boolean         @default(true)
  castShadow       Boolean         @default(true)
  receiveShadow    Boolean         @default(true)

  // Interaction
  interactionType  InteractionType @default(NONE)
  interactionData  Json?
  interactionRadius Float          @default(1.0)

  // Product linkage
  productId        String?
  productVariantId String?

  // Light config
  lightConfig      Json?

  // Physics
  physicsConfig    Json?

  // Hierarchy
  parentId         String?
  parent           SceneNode?      @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children         SceneNode[]     @relation("NodeHierarchy")
  sortOrder        Int             @default(0)

  metadata         Json?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([worldId])
  @@index([nodeType])
  @@index([parentId])
}

model Shelf {
  id          String   @id @default(uuid())
  name        String
  dimensions  Json
  createdAt   DateTime @default(now())
}

// ────────────────────────────────────────────
// ASSETS (Registry — files live in bucket)
// ────────────────────────────────────────────

model Asset {
  id             String      @id @default(uuid())
  name           String
  type           AssetType   @default(MODEL)
  status         AssetStatus @default(UPLOADING)

  // Bucket references
  bucketKey      String
  bucketUrl      String
  thumbnailKey   String?
  thumbnailUrl   String?

  // File info
  fileName       String
  fileSize       BigInt      @default(0)
  mimeType       String?
  format         String?

  // Metadata
  description    String?
  category       String?
  tags           String[]    @default([])
  vendor         String?

  // 3D specifics
  polygonCount   Int?
  materialCount  Int?
  dimensions     Json?

  // Product linkage
  productId      String?
  sku            String?

  version        Int         @default(1)
  uploadedBy     String?

  sceneNodes     SceneNode[]
  worldAssets    WorldAsset[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([type])
  @@index([bucketKey])
  @@index([category])
}

model WorldAsset {
  id         String   @id @default(uuid())
  worldId    String
  world      World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  usageType  String?
  addedAt    DateTime @default(now())

  @@unique([worldId, assetId])
  @@index([worldId])
  @@index([assetId])
}

// ────────────────────────────────────────────
// PRODUCTS (Shopify Sync)
// ────────────────────────────────────────────

model Product {
  id              String   @id @default(uuid())
  shopifyId       String   @unique
  sku             String?
  name            String
  description     String?
  price           Float    @default(0)
  compareAtPrice  Float?
  vendor          String?
  tags            String[] @default([])
  images          Json     @default("[]")
  variants        Json     @default("[]")
  inventory       Int      @default(0)
  modelUrl        String?
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ────────────────────────────────────────────
// PUBLISHING
// ────────────────────────────────────────────

model PublishRecord {
  id             String          @id @default(uuid())
  worldId        String
  world          World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  appId          String
  app            Application     @relation(fields: [appId], references: [id], onDelete: Cascade)
  environmentId  String
  environment    AppEnvironment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  version        Int
  bucketKey      String
  bucketUrl      String
  contentHash    String
  jsonSize       BigInt          @default(0)
  assetUrls      Json?
  state          PublishState    @default(PENDING)
  publishedBy    String?
  errorMessage   String?
  metadata       Json?
  publishedAt    DateTime        @default(now())

  @@index([worldId])
  @@index([appId])
  @@index([environmentId])
  @@index([appId, environmentId, version])
}

// ────────────────────────────────────────────
// STORE CONFIG (Authored in Studio)
// ────────────────────────────────────────────

model StoreConfig {
  id                  String   @id @default(uuid())
  worldId             String?  @unique
  appId               String?

  // Branding
  storeName           String?
  storeTagline        String?
  logoUrl             String?
  faviconUrl          String?
  brandPrimary        String   @default("#007acc")
  brandSecondary      String   @default("#1e1e1e")
  brandAccent         String   @default("#4ade80")
  customFont          String?

  // Visual
  theme               String   @default("dark")
  backgroundColor     String   @default("#1a1a1a")
  skyboxUrl           String?
  cameraFov           Int      @default(60)
  showGrid            Boolean  @default(false)

  // Navigation
  controlMode         String   @default("orbit")
  moveSpeed           Float    @default(5.0)
  rotateSpeed         Float    @default(1.0)
  zoomMin             Float    @default(2.0)
  zoomMax             Float    @default(50.0)
  autoRotate          Boolean  @default(false)
  autoRotateSpeed     Float    @default(0.5)
  enablePan           Boolean  @default(true)
  mobileControls      Boolean  @default(true)

  // Products
  productHoverEffect  String   @default("highlight")
  productClickAction  String   @default("openModal")
  showPriceTags       Boolean  @default(true)
  priceFormat         String   @default("$0.00")
  currency            String   @default("USD")
  currencySymbol      String   @default("$")
  showStockStatus     Boolean  @default(true)
  labelStyle          String   @default("floating")

  // Performance
  qualityPreset       String   @default("medium")
  shadowQuality       String   @default("medium")
  textureQuality      String   @default("medium")
  enableLOD           Boolean  @default(true)
  maxDrawDistance     Float    @default(100.0)
  antialiasing        Boolean  @default(true)
  pixelRatio          Float    @default(1.0)

  // Audio
  enableSound         Boolean  @default(true)
  soundVolume         Float    @default(0.7)
  enableMusic         Boolean  @default(false)
  musicUrl            String?
  musicVolume         Float    @default(0.3)
  ambientAudioUrl     String?
  ambientVolume       Float    @default(0.5)

  // Commerce
  enableCart          Boolean  @default(true)
  cartPosition        String   @default("topRight")
  checkoutUrl         String?
  showDiscounts       Boolean  @default(true)
  showTax             Boolean  @default(false)
  freeShipThreshold   Float?

  // Analytics
  analyticsProvider   String?
  analyticsId         String?
  trackProductViews   Boolean  @default(true)
  trackClicks         Boolean  @default(true)
  trackHeatmaps       Boolean  @default(false)
  trackSessionTime    Boolean  @default(true)

  // SEO
  metaTitle           String?
  metaDescription     String?
  ogImageUrl          String?
  twitterCard         String?
  socialLinks         Json?

  // Advanced
  customCss           String?
  customJs            String?
  featureFlags        Json?
  maintenanceMode     Boolean  @default(false)
  maintenanceMessage  String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([appId])
}

// ────────────────────────────────────────────
// LOGGING & COLLABORATION
// ────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String?
  entityId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model SyncLog {
  id         String   @id @default(uuid())
  type       String
  status     String
  details    Json?
  createdAt  DateTime @default(now())
}

model Comment {
  id          String        @id @default(uuid())
  worldId     String
  objectId    String?
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  message     String
  position    Json?
  status      CommentStatus @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@index([worldId])
  @@index([userId])
}